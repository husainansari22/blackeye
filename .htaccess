RewriteEngine On

# Branded 404 (replaces Hostinger default page)
ErrorDocument 404 /404.html

# Canonical host: www → acctventa.com
RewriteCond %{HTTP_HOST} ^www\.acctventa\.com$ [NC]
RewriteRule ^(.*)$ https://acctventa.com/$1 [L,R=301]

# Never rewrite uploaded files
RewriteRule ^uploads/ - [L]

# Auth routes → landing page signup/login views
RewriteRule ^auth/sign-up/?$ /index.html?page=signup [L,QSA]
RewriteRule ^auth/sign-in/?$ /index.html?page=login [L,QSA]
RewriteRule ^auth/login/?$ /index.html?page=login [L,QSA]
RewriteRule ^auth/admin/?$ /admin/ [L,QSA]

# Google / legacy auth URLs (must not 404)
RewriteRule ^user/login/?$ /index.html?page=login [L,QSA]
RewriteRule ^user/sign-in/?$ /index.html?page=login [L,QSA]
RewriteRule ^user/signin/?$ /index.html?page=login [L,QSA]
RewriteRule ^user/register/?$ /index.html?page=signup [L,QSA]
RewriteRule ^user/sign-up/?$ /index.html?page=signup [L,QSA]
RewriteRule ^user/signup/?$ /index.html?page=signup [L,QSA]
RewriteRule ^users/login/?$ /index.html?page=login [L,QSA]
RewriteRule ^users/sign-up/?$ /index.html?page=signup [L,QSA]
RewriteRule ^account/login/?$ /index.html?page=login [L,QSA]
RewriteRule ^account/register/?$ /index.html?page=signup [L,QSA]

# Optional: /signup and /login shortcuts (directory index pages also exist as fallback)
RewriteRule ^signup/?$ /index.html?page=signup [L,QSA]
RewriteRule ^login/?$ /index.html?page=login [L,QSA]
RewriteRule ^browse/?$ /marketplace.html [L,QSA]
RewriteRule ^register/?$ /index.html?page=signup [L,QSA]

# Legacy / wrong subdomain paths → main site
RewriteRule ^app/?$ / [L,R=301]
RewriteCond %{HTTP_HOST} ^app\.acctventa\.com$ [NC]
RewriteRule ^(.*)$ https://acctventa.com/$1 [L,R=301]

# Old Google-indexed URLs (previous site version) → current pages
RewriteRule ^blog/?$ / [L,R=301]
RewriteRule ^blogs/?$ / [L,R=301]
RewriteRule ^blog-details/?$ / [L,R=301]
RewriteRule ^blog/.+ / [L,R=301]
RewriteRule ^social-account-details/?$ /marketplace [L,R=301]
RewriteRule ^social-account-details/.+ /marketplace [L,R=301]
RewriteRule ^home/?$ / [L,R=301]
RewriteRule ^dashboard/?$ /dashboard.html [L,R=301]
RewriteRule ^about/?$ / [L,R=301]
RewriteRule ^features/?$ / [L,R=301]
RewriteRule ^how-it-works/?$ / [L,R=301]
RewriteRule ^howitworks/?$ / [L,R=301]

# Public sitelink / legal pages
RewriteRule ^marketplace/?$ /marketplace.html [L]
RewriteRule ^sell/?$ /sell.html [L]
RewriteRule ^privacy/?$ /privacy.html [L]
RewriteRule ^terms/?$ /terms.html [L]
RewriteRule ^guidelines/?$ /guidelines.html [L]
RewriteRule ^company/?$ /company.html [L]

# Password reset page
RewriteRule ^reset/?$ /reset.html [L,QSA]

# Owner control panel
RewriteRule ^owner/?$ /owner/index.php [L,QSA]
