# Your private access code — only you should know this
ACCESS_CODE=change-me-to-something-secret

# Session signing secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-32-byte-hex-string

# LLM provider: openai | anthropic
LLM_PROVIDER=openai

# API keys (set at least one matching your provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model to use (optional — defaults shown)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Directory the agent can read/write/run commands in
WORKSPACE_PATH=/workspace
