generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      String   @default("SELLER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealsAsSeller Deal[] @relation("SellerDeals")
  dealsAsBuyer  Deal[] @relation("BuyerDeals")
  dealsAsAgent  Deal[] @relation("AgentDeals")
}

model Deal {
  id           String   @id @default(cuid())
  publicId     String   @unique
  type         String
  title        String
  description  String?
  amount       Int
  feePercent   Float    @default(4)
  feeAmount    Int
  sellerAmount Int
  status       String   @default("PENDING_PAYMENT")

  buyerEmail String?
  buyerPhone String?
  buyerName  String?

  sellerId String
  seller   User   @relation("SellerDeals", fields: [sellerId], references: [id])
  buyerId  String?
  buyer    User?  @relation("BuyerDeals", fields: [buyerId], references: [id])
  agentId  String?
  agent    User?  @relation("AgentDeals", fields: [agentId], references: [id])

  deliveryNote String?
  trackingInfo String?
  paystackRef  String?

  milestones   Milestone[]
  proofs       Proof[]
  disputes     Dispute[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Milestone {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title     String
  amount    Int
  sortOrder Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Proof {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type      String
  url       String
  note      String?
  createdAt DateTime @default(now())
}

model Dispute {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("OPEN")
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type        String
  amount      Int
  paystackRef String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}
